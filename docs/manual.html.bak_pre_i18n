<tr><th>Mesh<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">输入三角/四边网格。</span><span class="en">Input mesh.</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
<tr><th>Level<span class="type">Int</span></th><td><div class="desc"><span class="zh">细分次数（≥0）。</span><span class="en">Subdivision levels.</span></div><div class="def">default=<code>1</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
</tbody></table>
