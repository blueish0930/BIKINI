<tr><th>Min<span class="type">Float</span></th><td><div class="desc"><span class="zh">较小主曲率 k_min。</span><span class="en">Smaller principal curvature k_min.</span></div></td></tr><tr><th>Max<span class="type">Float</span></th><td><div class="desc"><span class="zh">较大主曲率 k_max。</span><span class="en">Larger principal curvature k_max.</span></div></td></tr><tr><th>Min Direction<span class="type">Vector</span></th><td><div class="desc"><span class="zh">k_min 的单位切向。</span><span class="en">Unit tangent direction of k_min.</span></div></td></tr><tr><th>Max Direction<span class="type">Vector</span></th><td><div class="desc"><span class="zh">k_max 的单位切向。</span><span class="en">Unit tangent direction of k_max.</span></div></td></tr>
