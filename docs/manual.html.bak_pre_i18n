<tr><th>Mesh A<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">第一个三角表面。</span><span class="en">First triangle surface.</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr><tr><th>Mesh B<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">第二个三角表面。</span><span class="en">Second triangle surface.</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
</tbody></table>
  <h2>Outputs</h2>
  <table class="io-table"><thead><tr><th style="width:32%"><span class="zh">名称</span><span class="en">Name</span></th><th><span class="zh">用途 / 显示条件</span><span class="en">Purpose / visibility</span></th></tr></thead><tbody>
<tr><th>Intersect<span class="type">Boolean</span></th><td><div class="desc"><span class="zh">A 与 B 的任意三角相交则为真。</span><span class="en">True if any triangles of A and B intersect.</span></div></td></tr>
</tbody></table>
  
