<!DOCTYPE html>
<html lang="zh-CN" data-lang="zh">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BIKINI User Manual</title>
<style>
/* Match docs.blender.org Furo theme (light) — official color tokens */
:root{
  --font-stack:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji";
  --font-stack--monospace:"SFMono-Regular",Menlo,Consolas,Monaco,"Liberation Mono","Lucida Console",monospace;
  --color-foreground-primary:#000;
  --color-foreground-secondary:#5a5c63;
  --color-foreground-muted:#6b6f76;
  --color-foreground-border:#878787;
  --color-background-primary:#fff;
  --color-background-secondary:#f8f9fb;
  --color-background-hover:#efeff4;
  --color-background-border:#eeebee;
  --color-brand-primary:#0a4bff;
  --color-brand-content:#2757dd;
  --color-inline-code-background:var(--color-background-secondary);
  --color-header-background:var(--color-background-primary);
  --color-header-border:var(--color-background-border);
  --color-sidebar-background:var(--color-background-secondary);
  --color-sidebar-background-border:var(--color-background-border);
  --color-sidebar-link-text:var(--color-foreground-secondary);
  --color-sidebar-caption-text:var(--color-foreground-muted);
  --color-sidebar-section-text:var(--color-foreground-primary);
  --color-link:var(--color-brand-content);
  --color-table-header-background:var(--color-background-secondary);
  --color-table-border:var(--color-background-border);
  --sidebar-width:15.5rem;
  --header-height:2.5rem;
  --font-size--normal:100%;
  --font-size--small:92%;
  --font-size--small--2:87.5%;
  --sidebar-item-font-size:var(--font-size--small);
  --sidebar-item-line-height:1.35rem;
  --sidebar-item-spacing-vertical:.45rem;
  --sidebar-item-spacing-horizontal:1rem;
  --sidebar-left-inset:.4rem;
  font-size:18px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:var(--font-stack);
  color:var(--color-foreground-primary);
  background:var(--color-background-primary);
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
/* Wide screens: continuous sidebar gray from viewport left through the nav column */
@media(min-width:72.01rem){
  body{
    background-image:linear-gradient(
      to right,
      var(--color-sidebar-background) 0,
      var(--color-sidebar-background) calc((100vw - 72rem) / 2 + var(--sidebar-left-inset) + var(--sidebar-width)),
      var(--color-background-primary) calc((100vw - 72rem) / 2 + var(--sidebar-left-inset) + var(--sidebar-width))
    );
    background-attachment:fixed;
  }
}
html[data-lang="en"] .zh{display:none!important}
html[data-lang="zh"] .en{display:none!important}

/* Header — plain white like Furo */
.md-header{
  position:sticky;top:0;z-index:40;
  background:var(--color-header-background);
  border-bottom:1px solid var(--color-header-border);
}
.md-header__inner{
  max-width:72rem;margin:0 auto;padding:0 1.25rem 0 var(--sidebar-left-inset);
  height:var(--header-height);
  display:flex;align-items:center;gap:1rem;
}
.md-header__title{
  font-weight:700;font-size:1.1rem;
  color:var(--color-foreground-primary);
}
.md-header__title .sub{
  font-weight:400;color:var(--color-foreground-secondary);
  margin-left:.35rem;font-size:.95rem;
}
.md-header a{
  color:var(--color-foreground-secondary);
  text-decoration:none;font-size:var(--font-size--small);
  font-weight:400;
}
.md-header a:hover{color:var(--color-foreground-primary)}
.lang-switch{
  margin-left:auto;display:inline-flex;gap:0;
  border:1px solid var(--color-background-border);
  border-radius:.2rem;overflow:hidden;
  background:var(--color-background-secondary);
}
.lang-switch button{
  appearance:none;border:0;background:transparent;
  font:inherit;font-size:var(--font-size--small--2);
  color:var(--color-foreground-secondary);
  padding:.3rem .65rem;cursor:pointer;
}
.lang-switch button[aria-pressed="true"]{
  color:var(--color-foreground-primary);
  background:var(--color-background-primary);
  font-weight:600;
}
.nav-toggle{
  display:none;appearance:none;border:0;background:transparent;
  color:var(--color-foreground-primary);font-size:1.15rem;cursor:pointer;
}

/* Layout: smaller left inset; continuous sidebar bg */
.layout{
  display:flex;
  min-height:calc(100vh - var(--header-height));
  max-width:72rem;
  margin:0 auto;
  padding:0 1.25rem 0 0;
  gap:0;
  background:linear-gradient(
    to right,
    var(--color-sidebar-background) 0,
    var(--color-sidebar-background) calc(var(--sidebar-left-inset) + var(--sidebar-width)),
    var(--color-background-primary) calc(var(--sidebar-left-inset) + var(--sidebar-width))
  );
}
.sidebar{
  width:var(--sidebar-width);min-width:var(--sidebar-width);
  background:var(--color-sidebar-background);
  border-right:1px solid var(--color-sidebar-background-border);
  position:sticky;top:var(--header-height);align-self:flex-start;
  height:calc(100vh - var(--header-height));
  overflow:auto;
  padding:1rem .4rem 2.5rem var(--sidebar-left-inset);
  margin:0;
}
.nav-title{
  padding:.25rem var(--sidebar-item-spacing-horizontal) .5rem;
  font-size:var(--font-size--small--2);
  font-weight:700;
  color:var(--color-sidebar-caption-text);
  text-transform:uppercase;
  letter-spacing:.04em;
}
.nav-list{list-style:none;margin:0;padding:0}

/* Intro / Achieve — gray like official secondary links (not blue) */
.sidebar > .nav-list .nav-link{
  display:block;
  padding:var(--sidebar-item-spacing-vertical) var(--sidebar-item-spacing-horizontal);
  color:var(--color-sidebar-link-text);
  text-decoration:none;
  font-size:var(--sidebar-item-font-size);
  font-weight:500;
  line-height:var(--sidebar-item-line-height);
  background:transparent;
  border:0;border-radius:0;box-shadow:none;
}
.sidebar > .nav-list .nav-link:hover{
  color:var(--color-foreground-primary);
  background:var(--color-background-hover);
}
.sidebar > .nav-list .nav-link.is-active{
  color:var(--color-foreground-primary);
  font-weight:600;
  background:transparent;
  box-shadow:none;
}

/* Categories (parent) — black/gray, never brand blue */
.nav-fold{
  margin:0;border:0;border-radius:0;
  background:transparent;overflow:visible;
}
.nav-fold > summary{
  list-style:none;cursor:pointer;user-select:none;
  display:flex;align-items:center;gap:.4rem;
  padding:var(--sidebar-item-spacing-vertical) var(--sidebar-item-spacing-horizontal);
  font-size:var(--sidebar-item-font-size);
  font-weight:600;
  color:var(--color-sidebar-section-text);
  background:transparent;
  text-transform:none;letter-spacing:normal;
  border:0;
}
.nav-fold[open] > summary{
  border:0;background:transparent;
}
.nav-fold > summary::-webkit-details-marker{display:none}
.nav-fold > summary::before{
  content:"";
  width:.35em;height:.35em;
  border-right:1.5px solid var(--color-foreground-muted);
  border-bottom:1.5px solid var(--color-foreground-muted);
  transform:rotate(-45deg);
  margin-right:.15rem;
  flex-shrink:0;
  transition:transform .15s ease;
  opacity:.75;
}
.nav-fold[open] > summary::before{
  transform:rotate(45deg);
  margin-top:-.1em;
}
.nav-fold > summary:hover{
  color:var(--color-foreground-primary);
  background:var(--color-background-hover);
}
.nav-fold > summary .count{
  margin-left:auto;
  font-size:var(--font-size--small--2);
  font-weight:400;
  color:var(--color-foreground-muted);
  background:transparent;
  padding:0;
  border-radius:0;
}
/* Child list: vertical nest line */
.nav-fold > .nav-list{
  margin:0 0 .4rem .9rem;
  padding:.1rem 0 .35rem .7rem;
  border-left:1px solid #d0d2d8;
  background:transparent;
}
.nav-fold > .nav-list .nav-link{
  display:block;
  position:relative;
  padding:calc(var(--sidebar-item-spacing-vertical) * .85)
          var(--sidebar-item-spacing-horizontal)
          calc(var(--sidebar-item-spacing-vertical) * .85)
          .55rem;
  font-size:var(--sidebar-item-font-size);
  font-weight:400;
  line-height:var(--sidebar-item-line-height);
  color:var(--color-sidebar-link-text);
  text-decoration:none;
  border-radius:0;margin:0;
  background:transparent;box-shadow:none;border:0;
}
.nav-fold > .nav-list .nav-link::before{
  content:"";
  position:absolute;
  left:-.7rem;
  top:50%;
  width:.45rem;
  height:0;
  border-top:1px solid #d0d2d8;
}
.nav-fold > .nav-list .nav-link:hover{
  color:var(--color-foreground-primary);
  background:var(--color-background-hover);
}
.nav-fold > .nav-list .nav-link.is-active{
  color:var(--color-foreground-primary);
  font-weight:600;
  background:transparent;
  box-shadow:none;
}

/* Content */
.content{flex:1;min-width:0;background:var(--color-background-primary)}
.content-inner{
  max-width:48rem;
  padding:1.5rem 2rem 3rem 1.75rem;
  font-size:1.05rem;
}
.page{display:none}.page.is-active{display:block}
h1{
  margin:0 0 .75rem;
  font-size:2.05em;font-weight:700;line-height:1.25;
  color:var(--color-foreground-primary);
  border:0;
}
h2{
  margin:1.75rem 0 1rem;
  font-size:1.45em;font-weight:700;
  color:var(--color-foreground-primary);
  border-bottom:1px solid var(--color-background-border);
  padding-bottom:.35em;
}
h3{
  margin:1.25rem 0 .75rem;
  font-size:1.2em;font-weight:700;
  color:var(--color-foreground-primary);
}
p{margin:0 0 1em;max-width:none}
.lead{color:var(--color-foreground-secondary)}
ul,ol{margin:0 0 1em;padding-left:1.4em;color:var(--color-foreground-primary)}
li{margin:.25em 0}
a{color:var(--color-link);text-decoration:none}
a:hover{text-decoration:underline}
code{
  font-family:var(--font-stack--monospace);
  font-size:var(--font-size--small--2);
  background:var(--color-inline-code-background);
  padding:.1em .3em;border-radius:.2rem;
  color:var(--color-foreground-primary);
}

/* Tables — Furo-like simple */
.io-table{
  width:100%;max-width:46rem;
  border-collapse:collapse;
  margin:0 0 1.25em;
  font-size:var(--font-size--normal);
}
.io-table th,.io-table td{
  text-align:left;vertical-align:top;
  padding:.5rem .65rem;
  border-bottom:1px solid var(--color-table-border);
}
.io-table thead th{
  background:var(--color-table-header-background);
  font-weight:700;
  color:var(--color-foreground-primary);
}
.io-table th{font-weight:700;color:var(--color-foreground-primary)}
.io-table td{color:var(--color-foreground-primary)}
.io-table .type{
  display:inline;margin-left:.35rem;
  font-size:var(--font-size--small--2);
  font-weight:400;
  color:var(--color-foreground-muted);
  background:transparent;padding:0;border-radius:0;
}
.io-table .when{
  margin-top:.35rem;padding:0;
  background:transparent;border-radius:0;
  font-size:var(--font-size--small);
  color:var(--color-foreground-secondary);
}
.io-table .when code{
  background:var(--color-inline-code-background);
  color:var(--color-foreground-primary);
}
.io-table .desc{margin:0 0 .35rem;color:var(--color-foreground-primary);line-height:1.5}
.io-table .menu-line{margin:.2rem 0;color:var(--color-foreground-secondary);font-size:var(--font-size--small)}
.io-table .def{margin-top:.2rem;font-size:var(--font-size--small);color:var(--color-foreground-secondary)}
.io-table tr.mode-row{background:var(--color-background-secondary)}
.io-table tr.mode-row th,.io-table tr.mode-row td{background:transparent}

.note-inline{font-size:var(--font-size--small);color:var(--color-foreground-secondary)}
.muted{color:var(--color-foreground-muted)}

/* Admonition tip — Furo important/tip style, no blue box */
.admonition{
  margin:1em 0;max-width:46rem;
  border-left:.2rem solid #00bfa5;
  background:transparent;
  border-radius:0;
  padding:.5rem 0 .5rem 1rem;
}
.admonition .title{
  font-weight:700;margin:0 0 .35em;
  color:var(--color-foreground-primary);
  font-size:var(--font-size--normal);
}
.admonition p{margin:0 0 .4em}
.admonition p:last-child{margin-bottom:0}

.node-badge{
  display:block;
  font-size:var(--font-size--small);
  font-weight:400;
  color:var(--color-foreground-muted);
  background:transparent;
  padding:0;margin:0 0 .75rem;
  border-radius:0;
}
.node-badge code{
  background:var(--color-inline-code-background);
  font-weight:400;
}
.src{color:var(--color-foreground-secondary);font-size:var(--font-size--small);margin-top:1.5rem}

/* Status chips — muted, not bright blue */
.st{
  display:inline-block;padding:.05em .4em;border-radius:.15rem;
  font-size:var(--font-size--small--2);font-weight:600;
  background:var(--color-background-secondary);
  color:var(--color-foreground-secondary);
  border:1px solid var(--color-background-border);
}
.st.ok{color:#21632c;border-color:#38a84d55;background:transparent}
.st.wf{color:var(--color-foreground-secondary);background:transparent}
.st.miss{color:#b30000;border-color:#ff5c5c55;background:transparent}
.st.off{color:var(--color-foreground-muted);background:transparent}

footer.page-footer{
  margin-top:2.5em;padding-top:1em;
  border-top:1px solid var(--color-background-border);
  color:var(--color-foreground-secondary);
  font-size:var(--font-size--small);
}

@media(max-width:960px){
  .layout{
    flex-direction:column;padding:0 1rem;max-width:none;
    background:var(--color-background-primary);
  }
  .sidebar{
    position:fixed;left:0;top:var(--header-height);z-index:35;
    width:min(16rem,90vw);margin-left:0;padding-left:.75rem;
    transform:translateX(-105%);transition:transform .18s;
    box-shadow:none;
  }
  .nav-open .sidebar{transform:none;box-shadow:2px 0 12px rgba(0,0,0,.08)}
  .nav-toggle{display:inline-flex}
  .md-header__inner{padding:0 1rem;max-width:none}
}

/* Nested v1 / v2 folds */
.nav-fold > .nav-fold,
.nav-version > .nav-fold{
  margin:0 0 .15rem .85rem;
  padding:0 0 0 .15rem;
  border-left:1px solid #d0d2d8;
}
.nav-fold > .nav-fold > summary,
.nav-version > .nav-fold > summary{
  font-weight:600;
}
.nav-version{
  margin:0;border:0;background:transparent;
}
.nav-version > summary{
  list-style:none;cursor:pointer;user-select:none;
  display:flex;align-items:center;gap:.4rem;
  padding:var(--sidebar-item-spacing-vertical) var(--sidebar-item-spacing-horizontal);
  font-size:var(--sidebar-item-font-size);
  font-weight:700;
  color:var(--color-sidebar-section-text);
}
.nav-version > summary::-webkit-details-marker{display:none}
.nav-version > summary::before{
  content:"";width:.35em;height:.35em;
  border-right:1.5px solid var(--color-foreground-muted);
  border-bottom:1.5px solid var(--color-foreground-muted);
  transform:rotate(-45deg);margin-right:.15rem;flex-shrink:0;
  transition:transform .15s ease;opacity:.75;
}
.nav-version[open] > summary::before{transform:rotate(45deg);margin-top:-.1em}
.nav-version > summary:hover{background:var(--color-background-hover)}
.nav-version > summary .count,
.nav-version > summary .tag{
  margin-left:auto;font-size:var(--font-size--small--2);font-weight:400;
  color:var(--color-foreground-muted);
}

</style>
</head>
<body>
<header class="md-header"><div class="md-header__inner">
<button type="button" class="nav-toggle" id="nav-toggle">☰</button>
<div class="md-header__title">BIKINI <span class="sub en">User Manual</span><span class="sub zh">用户手册</span></div>
<a href="index.html"><span class="en">Docs</span><span class="zh">文档</span></a>
<a href="changelog.html"><span class="en">Developer</span><span class="zh">开发者</span></a>
<a href="https://github.com/blueish0930/BIKINI" target="_blank" rel="noopener">GitHub</a>
<div class="lang-switch">
<button type="button" id="lang-zh" aria-pressed="true">中文</button>
<button type="button" id="lang-en" aria-pressed="false">EN</button>
</div></div></header>
<div class="layout">
<aside class="sidebar">
<div class="nav-title">Manual</div>
<ul class="nav-list">
<li><a class="nav-link is-active" href="#intro" data-page="intro"><span class="zh">简介</span><span class="en">Intro</span></a></li>
<li><a class="nav-link" href="#achieve" data-page="achieve">Achieve List</a></li>
</ul>
<details class="nav-version">
<summary>v1 <span class="count">62</span></summary>
<details class="nav-fold" open><summary>Geometry Nodes <span class="count">30</span></summary>
<ul class="nav-list"><li><a class="nav-link" href="#GeometryNodeNamedPortal" data-page="GeometryNodeNamedPortal">Named Portal</a></li><li><a class="nav-link" href="#GeometryNodeStoreNamedPortal" data-page="GeometryNodeStoreNamedPortal">Store Named Portal</a></li><li><a class="nav-link" href="#GeometryNodeGeometryClip" data-page="GeometryNodeGeometryClip">Geometry Clip</a></li><li><a class="nav-link" href="#GeometryNodeSetClosureDefault" data-page="GeometryNodeSetClosureDefault">Set Default Closure</a></li><li><a class="nav-link" href="#GeometryNodeLoopSubdivision" data-page="GeometryNodeLoopSubdivision">Loop Subdivision</a></li><li><a class="nav-link" href="#GeometryNodeKNearest" data-page="GeometryNodeKNearest">Nearest Neighbors</a></li><li><a class="nav-link" href="#GeometryNodeDebug" data-page="GeometryNodeDebug">Debug</a></li><li><a class="nav-link" href="#NodeEnableInput" data-page="NodeEnableInput">Enable Input</a></li><li><a class="nav-link" href="#NodeEnableOutput" data-page="NodeEnableOutput">Enable Output</a></li><li><a class="nav-link" href="#GeometryNodeTimeShift" data-page="GeometryNodeTimeShift">Time Shift</a></li><li><a class="nav-link" href="#GeometryNodeSparseMatrixMath" data-page="GeometryNodeSparseMatrixMath">Sparse Matrix Math</a></li><li><a class="nav-link" href="#GeometryNodeLinearSolver" data-page="GeometryNodeLinearSolver">Linear Solver</a></li><li><a class="nav-link" href="#GeometryNodeMeshLaplacian" data-page="GeometryNodeMeshLaplacian">Mesh Laplacian</a></li><li><a class="nav-link" href="#GeometryNodeObjectInfo" data-page="GeometryNodeObjectInfo">Object Info</a></li><li><a class="nav-link" href="#GeometryNodeSelectElements" data-page="GeometryNodeSelectElements">Select Elements</a></li><li><a class="nav-link" href="#GeometryNodeEditElements" data-page="GeometryNodeEditElements">Edit Elements</a></li><li><a class="nav-link" href="#GeometryNodeHeatGeodesic" data-page="GeometryNodeHeatGeodesic">Heat Geodesic</a></li><li><a class="nav-link" href="#GeometryNodeInstantMeshes" data-page="GeometryNodeInstantMeshes">Instant Meshes</a></li><li><a class="nav-link" href="#GeometryNodeQuadWild" data-page="GeometryNodeQuadWild">QuadWild</a></li><li><a class="nav-link" href="#GeometryNodeTriangleRemesh" data-page="GeometryNodeTriangleRemesh">Triangle Remesh</a></li><li><a class="nav-link" href="#GeometryNodeVoronoiFracture" data-page="GeometryNodeVoronoiFracture">Voronoi Fracture</a></li><li><a class="nav-link" href="#GeometryNodeDelaunay3D" data-page="GeometryNodeDelaunay3D">Delaunay 3D</a></li><li><a class="nav-link" href="#GeometryNodeWriteAtIndex" data-page="GeometryNodeWriteAtIndex">Write at Index</a></li><li><a class="nav-link" href="#GeometryNodeRBFInterpolate" data-page="GeometryNodeRBFInterpolate">RBF Interpolate</a></li><li><a class="nav-link" href="#GeometryNodeMeshGraphColoring" data-page="GeometryNodeMeshGraphColoring">Mesh Graph Coloring</a></li><li><a class="nav-link" href="#GeometryNodeTangentField" data-page="GeometryNodeTangentField">Tangent Field</a></li><li><a class="nav-link" href="#GeometryNodeMeshGradient" data-page="GeometryNodeMeshGradient">Mesh Gradient</a></li><li><a class="nav-link" href="#GeometryNodeMeshDivergence" data-page="GeometryNodeMeshDivergence">Mesh Divergence</a></li><li><a class="nav-link" href="#GeometryNodeCurveIntersections" data-page="GeometryNodeCurveIntersections">Curve Intersections</a></li><li><a class="nav-link" href="#NodeExpression" data-page="NodeExpression">Expression</a></li></ul></details>
<details class="nav-fold" open><summary><span class="zh">界面 UI 与快捷操作</span><span class="en">UI &amp; Shortcuts</span> <span class="count">10</span></summary>
