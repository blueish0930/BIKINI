<tr><th>Points<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">球心（点云或网格顶点）。</span><span class="en">Sphere centers (point cloud or mesh vertices).</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr><tr><th>Radius<span class="type">Float</span></th><td><div class="desc"><span class="zh">未使用半径场时采用此均匀半径。</span><span class="en">Used when the Radius field is unused.</span></div><div class="def">default=<code>1.0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr><tr><th>Point Radius<span class="type">Float</span></th><td><div class="desc"><span class="zh">逐点球半径场。</span><span class="en">Per-point sphere radius field.</span></div><div class="def">default=<code>1.0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr><tr><th>Segments<span class="type">Int</span></th><td><div class="desc"><span class="zh">每个相交圆的段数。</span><span class="en">Segments per intersection circle.</span></div><div class="def">default=<code>32</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
