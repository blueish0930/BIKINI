<tr><th>Mesh<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">球心在凸包内的最大空球的 UV 球面。</span><span class="en">UV sphere of the largest empty ball whose center is inside the convex hull.</span></div></td></tr><tr><th>Center<span class="type">Vector</span></th><td><div class="desc"><span class="zh">该空球的球心。</span><span class="en">Center of that empty sphere.</span></div></td></tr><tr><th>Radius<span class="type">Float</span></th><td><div class="desc"><span class="zh">该空球的半径。</span><span class="en">Radius of that empty sphere.</span></div></td></tr>
