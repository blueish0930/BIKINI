<tr><th>Inside<span class="type">Bool</span></th><td><div class="desc"><span class="zh">是否只保留内部。</span><span class="en">Keep interior only.</span></div><div class="def">default=<code>True</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
<tr><th>Max Neighbors<span class="type">Int</span></th><td><div class="desc"><span class="zh">最大邻居数上限。</span><span class="en">Max neighbor cap.</span></div><div class="def">default=<code>0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
