  <table class="io-table"><thead><tr><th style="width:32%"><span class="zh">名称</span><span class="en">Name</span></th><th><span class="zh">用途 / 菜单 / 显示条件</span><span class="en">Purpose / menu / visibility</span></th></tr></thead><tbody>
<tr><th>Mesh<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">可能含退化元素的网格。</span><span class="en">Mesh that may contain degenerates.</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
</tbody></table>
  <h2>Outputs</h2>
  <table class="io-table"><thead><tr><th style="width:32%"><span class="zh">名称</span><span class="en">Name</span></th><th><span class="zh">用途 / 显示条件</span><span class="en">Purpose / visibility</span></th></tr></thead><tbody>
<tr><th>Mesh<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">无退化面/边的网格。</span><span class="en">Mesh without degenerate faces/edges.</span></div></td></tr>
</tbody></table>
  
