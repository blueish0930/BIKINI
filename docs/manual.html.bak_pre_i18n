<tr><th>Frame<span class="type">Int</span></th><td><div class="desc"><span class="zh">目标帧。</span><span class="en">Target frame.</span></div><div class="def">default=<code>1</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>始终显示 / always</code></div></td></tr>
</tbody></table>
  <h2>Outputs</h2>
  <table class="io-table"><thead><tr><th style="width:32%"><span class="zh">名称</span><span class="en">Name</span></th><th><span class="zh">用途 / 显示条件</span><span class="en">Purpose / visibility</span></th></tr></thead><tbody>
<tr><th>Geometry<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">要偏移时间求值的几何。</span><span class="en">Geometry evaluated at shifted time.</span></div></td></tr>
