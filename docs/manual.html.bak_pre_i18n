<tr><th>Geometry<span class="type">Geometry</span></th><td><div class="desc"><span class="zh">透传几何。</span><span class="en">Pass-through geometry.</span></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Vector, Color, Quaternion, 4x4 Matrix, String}</code></div></td></tr>
<tr><th>Selection<span class="type">Bool</span></th><td><div class="desc"><span class="zh">仅在选中元素上显示。</span><span class="en">Show only on selected elements.</span></div><div class="def">default=<code>True</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Vector, Color, Quaternion, 4x4 Matrix, String}</code></div></td></tr>
<tr><th>Value<span class="type">Float</span></th><td><div class="desc"><span class="zh">要叠加显示的场值。</span><span class="en">Field value to overlay.</span></div><div class="def">default=<code>0.0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Vector, Color, Quaternion, 4x4 Matrix, String}</code></div></td></tr>
<tr><th>Text Size<span class="type">FloatPixel</span></th><td><div class="desc"><span class="zh">叠加文字大小。</span><span class="en">Overlay text size.</span></div><div class="def">default=<code>11.0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Color, Quaternion, 4x4 Matrix, String}</code></div></td></tr>
<tr><th>Opacity<span class="type">FloatFactor</span></th><td><div class="desc"><span class="zh">叠加不透明度。</span><span class="en">Overlay opacity.</span></div><div class="def">default=<code>1.0</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Color}</code></div></td></tr>
<tr><th>Exclude Backfaces<span class="type">Bool</span></th><td><div class="desc"><span class="zh">是否排除背向面。</span><span class="en">Exclude backfaces.</span></div><div class="def">default=<code>True</code></div><div class="when"><span class="zh">显示条件</span><span class="en">Shown when</span>: <code>Data Type ∈ {Float, Integer, Boolean, Vector, Color, Quaternion, 4x4 Matrix, String}</code></div></td></tr>
</tbody></table>
  <h2>Outputs</h2>
  <table class="io-table"><thead><tr><th style="width:32%"><span class="zh">名称</span><span class="en">Name</span></th><th><span class="zh">用途 / 显示条件</span><span class="en">Purpose / visibility</span></th></tr></thead><tbody>
