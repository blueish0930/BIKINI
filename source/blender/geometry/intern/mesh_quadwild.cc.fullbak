/**
 * QuadWild Geometry Node backend.
 *
 * Spawns the official QuadWild-BiMDF CLI tools (GPL-3) shipped next to blender.exe:
 *   <program_dir>/quadwild/quadwild[.exe]
 *   <program_dir>/quadwild/quad_from_patches[.exe]
 *
 * Pipeline (from cgg-bern/quadwild-bimdf release notes):
 *   1) quadwild <mesh.obj> 2 <prep_config.txt>     → remesh + field + tracing
 *   2) quad_from_patches <mesh_rem_p0.obj> 1 <main_config.txt>
 *        → *_quadrangulation[_smooth].obj
 */

